{
  "name": "@ringfall/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "node --env-file-if-exists=../../.env.local dist/index.js",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "sql": "tsx --env-file-if-exists=../../.env.local scripts/sql.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:function": "cd ../mobile && EXPO_PUBLIC_API_URL=/api CI=1 npx expo export --platform web --clear && cd ../server && node function/embed-web.mjs ../mobile/dist function/web-assets.ts && tsc -p tsconfig.function.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@neon/functions": "^0.11.0",
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "@ringfall/rules": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
